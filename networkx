import networkx as nx
import matplotlib.pyplot as plt

G = nx.Graph()
# 加带权重的边
G.add_edge("AI", "LLM", weight=0.8)
G.add_edge("AI", "RAG", weight=0.6)
G.add_edge("LLM", "RAG", weight=0.5)

# Louvain社区划分
communities = nx.community.louvain_communities(G, seed=42)
print(communities)

# 画图
nx.draw(G, with_labels=True)
plt.show()
